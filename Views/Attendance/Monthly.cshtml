@model Project_HR_1.Models.ViewModels.Modules.AttendanceMonthVM
@using Project_HR_1.Models.Hr.Modules
@using Project_HR_1.Services.HrModules
@{
    ViewData["Title"] = L.L("ملخص التحضير الشهري", "Monthly Attendance");
    var prev = new DateOnly(Model.Year, Model.Month, 1).AddMonths(-1);
    var next = new DateOnly(Model.Year, Model.Month, 1).AddMonths(1);
    string Letter(string s) => s switch { "present" => L.L("ح", "P"), "late" => L.L("ت", "L"), "absent" => L.L("غ", "A"), "leave" => L.L("إ", "V"), "remote" => L.L("ب", "R"), "holiday" => "·", _ => "" };
}

<div class="page-head">
    <div>
        <h2>@L.L("ملخص التحضير الشهري", "Monthly Attendance")</h2>
        <div class="sub">@L.L(HrCalendar.MonthNameAr(Model.Month), HrCalendar.MonthNameEn(Model.Month)) <span class="hm-num">@Model.Year</span> — @L.L($"أيام العمل حتى الآن: {Model.WorkingDaysSoFar}", $"Working days so far: {Model.WorkingDaysSoFar}")</div>
    </div>
    <div class="page-head-actions">
        <a class="btn btn-ghost btn-sm" asp-action="Index" asp-route-branchId="@Model.BranchId"><i class="fa-solid fa-fingerprint me-1"></i>@L.L("التحضير اليومي", "Daily sheet")</a>
        <button type="button" class="btn btn-ghost btn-sm" onclick="window.print()"><i class="fa-solid fa-print me-1"></i>@L.L("طباعة", "Print")</button>
    </div>
</div>

<div class="data-card">
    <form method="get" class="filter-bar">
        <a class="icon-btn" asp-action="Monthly" asp-route-year="@prev.Year" asp-route-month="@prev.Month" asp-route-branchId="@Model.BranchId"><i class="fa-solid @(L.L("fa-chevron-right","fa-chevron-left"))"></i></a>
        <select name="month" class="select-box" onchange="this.form.submit()">
            @for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(m == Model.Month ? "selected" : null)">@L.L(HrCalendar.MonthNameAr(m), HrCalendar.MonthNameEn(m))</option> }
        </select>
        <input type="number" name="year" value="@Model.Year" min="2000" max="2100" class="select-box" style="width:6.5rem" onchange="this.form.submit()" />
        <a class="icon-btn" asp-action="Monthly" asp-route-year="@next.Year" asp-route-month="@next.Month" asp-route-branchId="@Model.BranchId"><i class="fa-solid @(L.L("fa-chevron-left","fa-chevron-right"))"></i></a>
        <select name="branchId" class="select-box" onchange="this.form.submit()">
            <option value="">@L.L("كل الفروع", "All branches")</option>
            @foreach (var b in Model.Branches) { <option value="@b.Id" selected="@(Model.BranchId == b.Id ? "selected" : null)">@L.L(b.NameAr, b.NameEn)</option> }
        </select>
        <span class="hm-spacer"></span>
        <div class="hm-legend">
            @foreach (var s in AttendanceStatuses.All) { <span><i class="hm-dot @s.Code">@Letter(s.Code)</i>@L.L(s.Ar, s.En)</span> }
        </div>
    </form>

    <div class="table-wrap">
        <table class="hm-matrix">
            <thead>
                <tr>
                    <th class="nm">@L.L("الموظف", "Employee")</th>
                    @for (var d = 1; d <= Model.DaysInMonth; d++)
                    {
                        var dt = new DateOnly(Model.Year, Model.Month, d);
                        <th style="@(HrCalendar.IsWeekend(dt) ? "color:#cbd5e1" : null)">@d</th>
                    }
                    <th>@L.L("حضور", "Pres.")</th>
                    <th>@L.L("تأخير", "Late")</th>
                    <th>@L.L("غياب", "Abs.")</th>
                    <th>@L.L("إجازة", "Leave")</th>
                    <th>@L.L("دقائق التأخير", "Late min")</th>
                    <th>@L.L("النسبة", "Rate")</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="@(Model.DaysInMonth + 7)" class="hm-pad hm-muted">@L.L("لا يوجد موظفون", "No employees.")</td></tr>
            }
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td class="nm">@L.L(r.Employee.NameAr, r.Employee.NameEn)</td>
                    @for (var d = 1; d <= Model.DaysInMonth; d++)
                    {
                        var st = r.Days.GetValueOrDefault(d);
                        <td><i class="hm-dot @(st ?? "none")" title="@(st != null ? L.L(AttendanceStatuses.Get(st).Ar, AttendanceStatuses.Get(st).En) : "")">@(st != null ? Letter(st) : "")</i></td>
                    }
                    <td class="hm-strong">@r.Present</td>
                    <td style="color:#b45309">@r.Late</td>
                    <td style="color:#b91c1c">@r.Absent</td>
                    <td style="color:#1d4ed8">@r.Leave</td>
                    <td class="hm-num">@r.LateMinutes</td>
                    <td class="hm-num hm-strong">@(r.Rate.HasValue ? r.Rate + "%" : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
