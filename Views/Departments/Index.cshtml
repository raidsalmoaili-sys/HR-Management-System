@model Project_HR_1.Models.ViewModels.Management.DepartmentsListVM
@{ ViewData["Title"] = "Departments"; }

<div class="page-head">
    <div>
        <h2>@L.L("الإدارات", "Departments")</h2>
        <div class="sub">@L.L("كتالوج الإدارات لكل شركة", "Per-company department catalog")</div>
    </div>
    <div class="page-head-actions">
        @if (Model.CanCreate)
        {
            <button type="button" class="btn btn-accent btn-sm" data-modal-open="modal-create">
                <i class="fa-solid fa-plus me-1"></i>@L.L("إضافة إدارة", "Add Department")
            </button>
        }
    </div>
</div>

<div class="data-card">
    <div class="card-head">
        <div class="card-title"><i class="fa-solid fa-sitemap"></i>@L.L("كل الإدارات", "All Departments")</div>
        <span class="text-xs text-muted">@Model.Departments.Count @L.L("سجل", "rows")</span>
    </div>
    <form method="get" class="filter-bar">
        <select name="companyId" class="select-box" onchange="this.form.submit()">
            <option value="">@L.L("كل الشركات", "All companies")</option>
            @foreach (var c in Model.Companies)
            {
                var sel = Model.CompanyFilter == c.Id ? "selected" : null;
                <option value="@c.Id" selected="@sel">@L.L(c.NameAr, c.NameEn)</option>
            }
        </select>
    </form>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@L.L("الإدارة", "Department")</th>
                    <th>@L.L("الشركة", "Company")</th>
                    <th class="text-center">@L.L("نشط", "Active")</th>
                    <th class="text-end">@L.L("إجراءات", "Actions")</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Departments.Count == 0)
            {
                <tr class="empty"><td colspan="4">@L.L("لا توجد إدارات", "No departments.")</td></tr>
            }
            @foreach (var d in Model.Departments)
            {
                <tr>
                    <td class="font-semibold">@L.L(d.NameAr, d.NameEn)</td>
                    <td class="text-muted">@(d.Company != null ? L.L(d.Company.NameAr, d.Company.NameEn) : "—")</td>
                    <td class="text-center">
                        @if (d.IsActive)
                        {
                            <span class="badge badge-success">@L.L("نشط", "Active")</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">@L.L("متوقف", "Inactive")</span>
                        }
                    </td>
                    <td class="text-end whitespace-nowrap">
                        @if (Model.CanEdit)
                        {
                            <button type="button" class="icon-btn" data-modal-open="modal-edit-@d.Id"><i class="fa-solid fa-pen"></i></button>
                        }
                        @if (Model.CanDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@d.Id" method="post" class="inline" onsubmit="return confirm('@L.L("حذف؟", "Delete?")');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-btn icon-btn-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanCreate)
{
    var emptyVm = new Project_HR_1.Models.ViewModels.Management.DepartmentEditVM { Companies = Model.Companies };
    <dialog id="modal-create" class="modal">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-sitemap"></i></span><span class="mm-txt"><small>@L.L("الإدارات", "Departments")</small>@L.L("إدارة جديدة", "New Department")</span></span>
                <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <partial name="_DepartmentFields" model="emptyVm" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                <button type="submit" class="btn btn-primary">@L.L("إنشاء", "Create")</button>
            </div>
        </form>
    </dialog>
}

@if (Model.CanEdit)
{
    foreach (var d in Model.Departments)
    {
        var vm = new Project_HR_1.Models.ViewModels.Management.DepartmentEditVM
        {
            Id = d.Id, CompanyId = d.CompanyId, NameAr = d.NameAr, NameEn = d.NameEn, IsActive = d.IsActive,
            Companies = Model.Companies,
        };
        <dialog id="modal-edit-@d.Id" class="modal">
            <form method="post" asp-action="Edit" asp-route-id="@d.Id">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-pen-to-square"></i></span><span class="mm-txt"><small>@L.L("الإدارات", "Departments")</small>@L.L("تعديل الإدارة", "Edit Department")</span></span>
                    <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="modal-body">
                    <partial name="_DepartmentFields" model="vm" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                    <button type="submit" class="btn btn-primary">@L.L("حفظ", "Save")</button>
                </div>
            </form>
        </dialog>
    }
}
