    if (natEl) {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NationalityBreakdown.Select(x => x.Label)));
        const data   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.NationalityBreakdown.Select(x => x.Count)));
        const colors = ['#1a2744','#0d9488','#2563eb','#7c3aed','#d97706','#dc2626'];
        new Chart(natEl, {
            type: 'doughnut',
            data: { labels, datasets: [{ data, backgroundColor: colors, borderWidth: 2, borderColor: '#fff' }] },
            options: {
                cutout: '65%',
                plugins: { legend: { display: false } },
                animation: { duration: 600 }
            }
        });
    }

    // Department bar chart
    const deptEl = document.getElementById('deptChart');
    if (deptEl) {
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptBreakdown.Select(x => x.Label)));
        const data   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DeptBreakdown.Select(x => x.Count)));
        new Chart(deptEl, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    data, backgroundColor: '#1a2744',
                    borderRadius: 6, borderSkipped: false
                }]
            },
            options: {
                indexAxis: 'y',
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                    y: { grid: { display: false }, ticks: { font: { size: 11 } } }
                },
                animation: { duration: 600 }
            }
        });
    }
})();
</script>
}
