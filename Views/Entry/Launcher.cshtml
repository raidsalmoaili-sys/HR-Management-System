@model Project_HR_1.Models.ViewModels.Entry.LauncherVM
@using Project_HR_1.Services.Scope
@{
    ViewData["Title"] = "HR Services Hub";
    Layout = "_Layout";

    var allCategories = Model.Categories;
    var allServices   = Model.Services;
    var activeCat     = Model.Category;
    var searchQ       = Model.Search ?? "";

    var pinnedIds = new[] { "dashboard", "employees", "attendance", "leaves", "payroll", "tasks", "alerts", "org-structure" };
    var pinnedServices = Project_HR_1.Models.Hr.ServiceCatalog.Services
        .Where(s => pinnedIds.Contains(s.Id) && Model.AllowedServiceIds.Contains(s.Id))
        .ToList();

    var statsCards = new[]
    {
        new { Icon = "fa-users",               Color = "#1a2744", BgLight = "#eef0f6", Label = L.L("إجمالي الموظفين", "Total Employees"), Value = Model.Stats.TotalEmployees.ToString() },
        new { Icon = "fa-user-tie",            Color = "#0d9488", BgLight = "#e6faf8", Label = L.L("سعوديون",          "Saudis"),          Value = Model.Stats.SaudiCount.ToString() },
        new { Icon = "fa-earth-americas",      Color = "#2563eb", BgLight = "#eff6ff", Label = L.L("غير سعوديين",      "Non-Saudis"),      Value = Model.Stats.NonSaudiCount.ToString() },
        new { Icon = "fa-fingerprint",         Color = "#7c3aed", BgLight = "#f5f3ff", Label = L.L("حضور اليوم",       "Today's Attendance"), Value = Model.Stats.AttendanceToday > 0 ? Model.Stats.AttendanceToday.ToString() : "—" },
        new { Icon = "fa-umbrella-beach",      Color = "#0891b2", BgLight = "#ecfeff", Label = L.L("إجازات نشطة",      "Active Leaves"),    Value = Model.Stats.ActiveLeaves > 0 ? Model.Stats.ActiveLeaves.ToString() : "—" },
        new { Icon = "fa-triangle-exclamation",Color = "#dc2626", BgLight = "#fef2f2", Label = L.L("تنبيهات حرجة",    "Critical Alerts"),  Value = Model.Stats.PendingAlerts.ToString() },
    };

    var docTypeLabels = new Dictionary<string, (string Ar, string En, string Icon, string Color)>
    {
        ["iqama"]       = ("إقامة",      "Iqama",       "fa-id-card",     "#7c3aed"),
        ["national-id"] = ("هوية وطنية", "National ID", "fa-address-card","#0d9488"),
        ["passport"]    = ("جواز سفر",   "Passport",    "fa-passport",    "#2563eb"),
        ["contract"]    = ("عقد عمل",    "Contract",    "fa-file-contract","#d97706"),
    };

    string scopeLabel, scopeSubLabel, scopeIcon;
    string scopeColor = Model.Scope.Level switch {
        ScopeLevel.Branch  => "#0d9488",
        ScopeLevel.Company => "#c8a84b",
        _                  => "#7c3aed",
    };
    if (Model.Scope.Level == ScopeLevel.Branch && Model.ScopeCompany != null && Model.ScopeBranch != null)
    {
        scopeIcon     = "fa-code-branch";
        scopeLabel    = L.L(Model.ScopeCompany.NameAr, Model.ScopeCompany.NameEn);
        scopeSubLabel = L.L(Model.ScopeBranch.NameAr ?? "", Model.ScopeBranch.NameEn ?? "");
    }
    else if (Model.Scope.Level == ScopeLevel.Company && Model.ScopeCompany != null)
    {
        scopeIcon     = "fa-building";
        scopeLabel    = L.L(Model.ScopeCompany.NameAr, Model.ScopeCompany.NameEn);
        scopeSubLabel = L.L("نطاق الشركة", "Company scope");
    }
    else
    {
        scopeIcon     = "fa-globe";
        scopeLabel    = L.L("كل الشركات", "All Companies");
        scopeSubLabel = L.L("نطاق عام", "Global scope");
    }
}

<div class="db-shell">

    
    <aside class="db-sidebar">
        <div class="db-sidebar-inner">

        <div class="db-sidebar-top">
            <div class="db-sidebar-logo">
                <div class="db-sidebar-logo-ico">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div class="db-sidebar-logo-txt">
                    <div class="db-sidebar-logo-title">@L.L("الموارد البشرية", "HR System")</div>
                    <div class="db-sidebar-logo-sub">@L.L("لوحة التحكم", "Dashboard")</div>
                </div>
            </div>
            <div class="db-sidebar-scope-pill" style="--sc:@scopeColor">
                <i class="fa-solid @scopeIcon"></i>
                <span>@scopeLabel</span>
            </div>
        </div>

        <div class="db-search-wrap">
            <form method="get" action="@Url.Action("Launcher", "Entry")">
                <div class="db-search">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input type="text" name="q" value="@searchQ"
                           placeholder="@L.L("بحث في الخدمات…", "Search services…")" />
                </div>
            </form>
        </div>

        <nav class="db-nav">
            <a asp-action="Launcher" asp-route-q="@searchQ"
               class="db-nav-item @(string.IsNullOrEmpty(activeCat) && string.IsNullOrEmpty(searchQ) ? "is-active" : "")">
                <span class="db-nav-icon" style="--ic:#1a2744">
                    <i class="fa-solid fa-house"></i>
                </span>
                <span class="db-nav-label">@L.L("الرئيسية", "Home")</span>
            </a>

            <div class="db-nav-sep">@L.L("الخدمات", "Services")</div>

            @foreach (var cat in allCategories)
            {
                var catItems = Project_HR_1.Models.Hr.ServiceCatalog.ByCategory(cat.Id)
                               .Where(s => Model.AllowedServiceIds.Contains(s.Id)).ToList();
                if (catItems.Count == 0) continue;
                var cIcon  = catItems.First().Icon;
                var cColor = catItems.First().Color;
                var isAct  = activeCat == cat.Id;

                <div class="db-nav-group @(isAct ? "is-open" : "")">
                    <div class="db-nav-item @(isAct ? "is-active" : "") db-nav-cat-toggle">
                        <span class="db-nav-cat-link">
                            <span class="db-nav-icon" style="--ic:@cColor">
                                <i class="fa-solid @cIcon"></i>
                            </span>
                            <span class="db-nav-label">@L.L(cat.NameAr, cat.NameEn)</span>
                        </span>
                        <span class="db-nav-badge">@catItems.Count</span>
                        <button type="button" class="db-nav-toggle" aria-label="@L.L("تبديل","toggle")">
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                    </div>
                    <div class="db-nav-sub">
                        @foreach (var svc in catItems)
                        {
                            <a asp-controller="Service" asp-action="Show" asp-route-id="@svc.Id"
                               class="db-nav-sub-item">
                                <span class="db-sub-dot" style="background:@svc.Color"></span>
                                <span class="db-sub-label">@L.L(svc.NameAr, svc.NameEn)</span>
                                @if (svc.Badge.HasValue)
                                { <span class="db-nav-sub-badge">@svc.Badge</span> }
                            </a>
                        }
                    </div>
                </div>
            }
        </nav>

        <div class="db-sidebar-footer">
            <div class="db-sidebar-footer-info">
                <i class="fa-solid fa-circle-info"></i>
                <span>@L.L("النطاق الحالي", "Current Scope"): @scopeLabel</span>
            </div>
            <form method="post" asp-action="ChangeContext">
                <button type="submit" class="db-switch-btn">
                    <i class="fa-solid fa-right-left"></i>
                    @L.L("تغيير النطاق", "Switch Scope")
                </button>
            </form>
        </div>
        </div>@* end db-sidebar-inner *@
    </aside>

    <div class="db-main">

        @{/* Dashboard always visible */}
            <div class="db-scope-bar" style="--sc:@scopeColor">
                <div class="db-scope-ico"><i class="fa-solid @scopeIcon"></i></div>
                <div class="db-scope-txt">
                    <p class="db-scope-eyebrow">@L.L("النطاق الحالي", "Current Scope")</p>
                    <h2 class="db-scope-name">@scopeLabel</h2>
                    @if (!string.IsNullOrEmpty(scopeSubLabel))
                    { <p class="db-scope-sub">@scopeSubLabel</p> }
                </div>
            </div>

            
            @* ── Stats Row ── *@
            <div class="db-section-label">@L.L("نظرة عامة", "Overview")</div>
            <div class="db-stats-row">
                @foreach (var s in statsCards)
                {
                    <div class="db-stat" style="--sc:@s.Color;--sl:@s.BgLight">
                        <div class="db-stat-ico"><i class="fa-solid @s.Icon"></i></div>
                        <div class="db-stat-body">
                            <div class="db-stat-val">@s.Value</div>
                            <div class="db-stat-lbl">@s.Label</div>
                        </div>
                    </div>
                }
            </div>

            @* ── Quick Access ── *@
            @if (pinnedServices.Any())
            {
                <div class="db-section-label">@L.L("وصول سريع", "Quick Access")</div>
                <div class="db-quick-grid">
                    @foreach (var svc in pinnedServices)
                    {
                        <a asp-controller="Service" asp-action="Show" asp-route-id="@svc.Id"
                           class="db-quick-tile" style="--sc:@svc.Color">
                            @if (svc.Badge.HasValue)
                            { <span class="db-quick-badge">@svc.Badge</span> }
                            <div class="db-quick-ico"><i class="fa-solid @svc.Icon"></i></div>
                            <div class="db-quick-name">@L.L(svc.NameAr, svc.NameEn)</div>
                        </a>
                    }
                </div>
            }

            @* ── Data-quality alerts: each row opens the employee page to fix it manually ── *@
            @if (Model.DataIssues.Any())
            {
                var kinds = new[]
                {
                    ("no-id",       L.L("بدون رقم هوية/إقامة", "No ID / Iqama"),          "fa-id-card",           "#dc2626"),
                    ("no-branch",   L.L("بدون فرع",             "No branch"),              "fa-code-branch",       "#d97706"),
                    ("id-mismatch", L.L("الجنسية لا تطابق نوع الرقم", "Nationality ≠ ID type"), "fa-triangle-exclamation", "#7c3aed"),
                };
                <div class="db-section-label">@L.L("بيانات موظفين تحتاج إكمال", "Employee data to complete")</div>
                <div class="db-widget mb-6" id="data-issues">
                    <div class="db-widget-head">
                        <div class="db-widget-title">
                            <i class="fa-solid fa-bell" style="color:#dc2626"></i>
                            @L.L("اضغط على الموظف لفتح صفحته وإكمال بياناته", "Click an employee to open and fix their record")
                        </div>
                        <span class="db-widget-badge db-widget-badge--red">@Model.DataIssues.Count</span>
                    </div>
                    <div class="di-chips">
                        @foreach (var k in kinds)
                        {
                            var n = Model.DataIssues.Count(d => d.Kind == k.Item1);
                            if (n == 0) continue;
                            <button type="button" class="di-chip" data-kind="@k.Item1" style="--dc:@k.Item4">
                                <i class="fa-solid @k.Item3"></i> @k.Item2 <strong>@n</strong>
                            </button>
                        }
                    </div>
                    <div class="di-list">
                        @foreach (var d in Model.DataIssues.OrderBy(d => d.Kind).ThenBy(d => d.NameAr))
                        {
                            var k = kinds.First(x => x.Item1 == d.Kind);
                            <a asp-controller="Employees" asp-action="Detail" asp-route-id="@d.EmployeeId" class="di-row" data-kind="@d.Kind">
                                <span class="di-ico" style="--dc:@k.Item4"><i class="fa-solid @k.Item3"></i></span>
                                <span class="di-name">@L.L(d.NameAr, d.NameEn)</span>
                                <span class="di-code">#@d.EmployeeCode</span>
                                <span class="di-note">@d.Note</span>
                                <i class="fa-solid fa-chevron-left di-go"></i>
                            </a>
                        }
                    </div>
                </div>
                <style>
                    .di-chips { display:flex; flex-wrap:wrap; gap:.5rem; padding:.25rem 0 .75rem; }
                    .di-chip { display:inline-flex; align-items:center; gap:.4rem; border:1px solid color-mix(in srgb, var(--dc) 35%, transparent);
                               color:var(--dc); background:color-mix(in srgb, var(--dc) 8%, transparent); border-radius:999px; padding:.3rem .8rem; font-size:.8rem; cursor:pointer; }
                    .di-chip.active { background:var(--dc); color:#fff; }
                    .di-list { max-height:360px; overflow:auto; display:flex; flex-direction:column; }
                    .di-row { display:flex; align-items:center; gap:.75rem; padding:.55rem .5rem; border-top:1px solid #f1f5f9; color:inherit; text-decoration:none; font-size:.85rem; }
                    .di-row:hover { background:#f8fafc; }
                    .di-ico { width:28px; height:28px; border-radius:8px; display:grid; place-items:center; color:var(--dc); background:color-mix(in srgb, var(--dc) 12%, transparent); flex-shrink:0; }
                    .di-name { font-weight:600; }
                    .di-code { color:#94a3b8; font-size:.75rem; }
                    .di-note { color:#64748b; margin-inline-start:auto; font-size:.78rem; }
                    .di-go { color:#cbd5e1; font-size:.7rem; }
                    [dir="ltr"] .di-go { transform:scaleX(-1); }
                </style>
                <script>
                (function () {
                    const root = document.getElementById('data-issues'); if (!root) return;
                    const chips = root.querySelectorAll('.di-chip'), rows = root.querySelectorAll('.di-row');
                    chips.forEach(c => c.addEventListener('click', () => {
                        const on = !c.classList.contains('active');
                        chips.forEach(x => x.classList.remove('active'));
                        if (on) c.classList.add('active');
                        rows.forEach(r => r.style.display = (!on || r.dataset.kind === c.dataset.kind) ? '' : 'none');
                    }));
                })();
                </script>
            }

            @* ── Document Alerts + Nationality Chart ── *@
            <div class="db-section-label">@L.L("تنبيهات المستندات", "Document Alerts")</div>
            <div class="db-widgets-row">

                <div class="db-widget db-widget--lg">
                    <div class="db-widget-head">
                        <div class="db-widget-title">
                            <i class="fa-solid fa-triangle-exclamation" style="color:#dc2626"></i>
                            @L.L("انتهاء المستندات خلال 90 يوماً", "Documents Expiring within 90 Days")
                        </div>
                        @if (Model.ExpiryAlerts.Any())
                        { <span class="db-widget-badge db-widget-badge--red">@Model.ExpiryAlerts.Count</span> }
                    </div>
                    @if (!Model.ExpiryAlerts.Any())
                    {
                        <div class="db-widget-empty">
                            <i class="fa-solid fa-circle-check" style="color:#22c55e;font-size:2rem"></i>
                            <p>@L.L("لا توجد مستندات منتهية الصلاحية قريباً", "No documents expiring soon")</p>
                        </div>
                    }
                    else
                    {
                        <div class="db-alert-table-wrap">
                            <table class="db-alert-table">
                                <thead>
                                    <tr>
                                        <th>@L.L("الموظف", "Employee")</th>
                                        <th>@L.L("نوع المستند", "Document")</th>
                                        <th>@L.L("تاريخ الانتهاء", "Expiry")</th>
                                        <th>@L.L("المتبقي", "Days")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var alert in Model.ExpiryAlerts.Take(10))
                                    {
                                        var docInfo = docTypeLabels.GetValueOrDefault(alert.DocType,
                                            ("مستند", "Document", "fa-file", "#64748b"));
                                        <tr class="db-alert-row db-alert-row--@alert.Urgency">
                                            <td>
                                                <div class="db-alert-emp">
                                                    <div class="db-alert-avatar">@(alert.NameAr.Length >= 2 ? alert.NameAr[..2] : alert.NameAr)</div>
                                                    <span>@L.L(alert.NameAr, alert.NameEn)</span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="db-doc-chip" style="--dc:@docInfo.Item4">
                                                    <i class="fa-solid @docInfo.Item3"></i>
                                                    @L.L(docInfo.Item1, docInfo.Item2)
                                                </span>
                                            </td>
                                            <td class="db-alert-date">@alert.ExpiryDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                <span class="db-days-badge db-days-badge--@alert.Urgency">
                                                    @alert.DaysLeft @L.L("يوم", "d")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="db-widget db-widget--sm">
                    <div class="db-widget-head">
                        <div class="db-widget-title">
                            <i class="fa-solid fa-earth-americas" style="color:#2563eb"></i>
                            @L.L("توزيع الجنسيات", "Nationality Mix")
                        </div>
                    </div>
                    @if (!Model.NationalityBreakdown.Any())
                    {
                        <div class="db-widget-empty">
                            <i class="fa-solid fa-chart-pie" style="color:#cbd5e1;font-size:2rem"></i>
                            <p>@L.L("لا توجد بيانات", "No data yet")</p>
                        </div>
                    }
                    else
                    {
                        <div class="db-chart-wrap"><canvas id="natChart" height="200"></canvas></div>
                        <div class="db-chart-legend">
                            @{ var natColors = new[]{"#1a2744","#0d9488","#2563eb","#7c3aed","#d97706","#dc2626"}; }
                            @for (int ni = 0; ni < Model.NationalityBreakdown.Count; ni++)
                            {
                                var nb = Model.NationalityBreakdown[ni];
                                <div class="db-legend-item">
                                    <span class="db-legend-dot" style="background:@natColors[ni % natColors.Length]"></span>
                                    <span class="db-legend-lbl">@nb.Label</span>
                                    <span class="db-legend-val">@nb.Count</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ── Dept Chart + Expiry Summary ── *@
            <div class="db-section-label">@L.L("تحليلات القوى العاملة", "Workforce Analytics")</div>
            <div class="db-widgets-row">

                <div class="db-widget db-widget--md">
                    <div class="db-widget-head">
                        <div class="db-widget-title">
                            <i class="fa-solid fa-sitemap" style="color:#7c3aed"></i>
                            @L.L("توزيع الأقسام", "Department Headcount")
                        </div>
                    </div>
                    @if (!Model.DeptBreakdown.Any())
                    {
                        <div class="db-widget-empty">
                            <i class="fa-solid fa-chart-bar" style="color:#cbd5e1;font-size:2rem"></i>
                            <p>@L.L("لا توجد بيانات أقسام", "No department data yet")</p>
                        </div>
                    }
                    else
                    {
                        <div class="db-chart-wrap"><canvas id="deptChart" height="200"></canvas></div>
                    }
                </div>

                <div class="db-widget db-widget--md">
                    <div class="db-widget-head">
                        <div class="db-widget-title">
                            <i class="fa-solid fa-clock" style="color:#d97706"></i>
                            @L.L("ملخص انتهاء المستندات", "Expiry Summary")
                        </div>
                    </div>
                    <div class="db-expiry-summary">
                        @{
                            var docSummary = new[]
                            {
                                new { Key="iqama",       Ar="إقامة",      En="Iqama",       Icon="fa-id-card",       Color="#7c3aed" },
                                new { Key="national-id", Ar="هوية وطنية", En="National ID", Icon="fa-address-card",  Color="#0d9488" },
                                new { Key="passport",    Ar="جواز سفر",   En="Passport",    Icon="fa-passport",      Color="#2563eb" },
                                new { Key="contract",    Ar="عقد عمل",    En="Contract",    Icon="fa-file-contract", Color="#d97706" },
                            };
                        }
                        @foreach (var ds in docSummary)
                        {
                            var cnt      = Model.ExpiryAlerts.Count(a => a.DocType == ds.Key);
                            var critical = Model.ExpiryAlerts.Count(a => a.DocType == ds.Key && a.Urgency == "critical");
                            var warning  = Model.ExpiryAlerts.Count(a => a.DocType == ds.Key && a.Urgency == "warning");
                            <div class="db-expiry-card" style="--dc:@ds.Color">
                                <div class="db-expiry-ico"><i class="fa-solid @ds.Icon"></i></div>
                                <div class="db-expiry-info">
                                    <div class="db-expiry-name">@L.L(ds.Ar, ds.En)</div>
                                    <div class="db-expiry-chips">
                                        @if (critical > 0)
                                        { <span class="db-chip db-chip--red">@critical @L.L("حرج","crit")</span> }
                                        @if (warning > 0)
                                        { <span class="db-chip db-chip--orange">@warning @L.L("تحذير","warn")</span> }
                                        @if (cnt == 0)
                                        { <span class="db-chip db-chip--green">@L.L("لا شيء","OK")</span> }
                                    </div>
                                </div>
                                <div class="db-expiry-total">@cnt</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
    </div>
</div>

@section Scripts {
<style>
/* ── lock the page itself from scrolling ── */
html, body { overflow: hidden !important; height: 100% !important; }
.page-area { padding: 0 !important; max-width: 100% !important; overflow: hidden !important; height: calc(100vh - 64px) !important; }

/* ══════════════════════════════════════════
   SHELL — fixed viewport height, no page scroll
══════════════════════════════════════════ */
.db-shell {
    display: flex;
    height: calc(100vh - 64px);
    overflow: hidden;
}

/* ══════════════════════════════════════════
   SIDEBAR
══════════════════════════════════════════ */
.db-sidebar {
    width: 248px;
    flex-shrink: 0;
    background: #ffffff;
    border-inline-end: 1px solid #e2e8f0;
    box-shadow: 2px 0 8px rgba(0,0,0,.06);
}
.db-sidebar-inner {
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
}
.db-sidebar-inner::-webkit-scrollbar { width: 4px; }
.db-sidebar-inner::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }

/* top block */
.db-sidebar-top {
    padding: .75rem .875rem;
    border-bottom: 1px solid #e2e8f0;
    background: linear-gradient(180deg, #f8faff 0%, #ffffff 100%);
}
.db-sidebar-logo {
    display: flex; align-items: center; gap: .625rem;
    margin-bottom: .625rem;
}
.db-sidebar-logo-ico {
    width: 34px; height: 34px; border-radius: 9px;
    background: linear-gradient(135deg, #1a3a6b, #2563eb);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: .9rem; flex-shrink: 0;
    box-shadow: 0 2px 10px rgba(37,99,235,.35);
}
.db-sidebar-logo-title {
    font-size: .82rem; font-weight: 700; color: #0f172a;
    line-height: 1.2;
}
.db-sidebar-logo-sub {
    font-size: .65rem; color: #94a3b8; margin-top: 1px;
    text-transform: uppercase; letter-spacing: .06em;
}
.db-sidebar-scope-pill {
    display: flex; align-items: center; gap: .4rem;
    background: #f1f5f9;
    border: 1px solid #e2e8f0;
