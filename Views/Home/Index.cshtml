@{
    ViewData["Title"] = "Home";
    Layout = "_PublicLayout";
}

<div class="card max-w-2xl mx-auto text-center">
    <h1 class="text-2xl font-bold text-ink mb-3">@L.T("brand")</h1>
    <p class="text-muted mb-6">@L.T("welcomeP")</p>
    <div class="flex justify-center gap-3">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Entry" asp-action="Resume">@L.T("enter")</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">@L.T("auth_signin")</a>
        }
    </div>
</div>
