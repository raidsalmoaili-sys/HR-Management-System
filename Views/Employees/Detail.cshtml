@model Project_HR_1.Models.ViewModels.Management.EmployeeDetailVM
@{ ViewData["Title"] = Model.Employee.NameAr; }

<div class="flex items-center justify-between">
    <a asp-action="Index" class="text-muted text-sm hover:text-ink"><i class="fa-solid fa-arrow-left me-1"></i>@L.L("رجوع", "Back")</a>
    <div class="flex items-center gap-2">
        @if (Model.CanEdit)
        {
            <button type="button" class="btn btn-primary btn-sm" data-modal-open="modal-edit-basics">
                <i class="fa-solid fa-pen me-1"></i>@L.L("تعديل البيانات الأساسية", "Edit basic data")
            </button>
        }
        @if (Model.CanTransfer)
        {
            <button type="button" class="btn btn-ghost btn-sm" data-modal-open="modal-transfer">
                <i class="fa-solid fa-arrows-rotate me-1"></i>@L.L("نقل الموظف", "Transfer Employee")
            </button>
        }
        <form asp-action="Delete" asp-route-id="@Model.Employee.Id" method="post"
              onsubmit="return confirm('@L.L("هل أنت متأكد من حذف هذا الموظف؟ سيتم حذف حسابه أيضاً.", "Are you sure you want to delete this employee? Their account will also be deleted.")')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm bg-red-600 hover:bg-red-700 text-white">
                <i class="fa-solid fa-trash me-1"></i>@L.L("حذف الموظف", "Delete Employee")
            </button>
        </form>
    </div>
</div>

@if (TempData["err"] is string trErr && !string.IsNullOrEmpty(trErr))
{
    <div class="auth-error mb-4">
        <i class="fa-solid fa-circle-exclamation me-1"></i> @trErr
    </div>
}
@if (TempData["ok"] is string trOk && !string.IsNullOrEmpty(trOk))
{
    <div class="mb-4 rounded-lg bg-green-50 border border-green-200 px-4 py-3 text-sm text-green-700">
        <i class="fa-solid fa-circle-check me-1"></i> @trOk
    </div>
}

<div class="card p-6 my-4">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-14 h-14 rounded-full flex items-center justify-center text-white text-lg font-bold" style="background:@(Model.Employee.AvatarColor ?? "#1a2744")">@Model.Employee.Initials</div>
        <div>
            <h1 class="text-xl font-bold text-ink">@L.L(Model.Employee.NameAr, Model.Employee.NameEn)</h1>
            <div class="text-sm text-muted">@Model.Employee.EmployeeCode@(string.IsNullOrEmpty(Model.Employee.Email) ? "" : " · " + Model.Employee.Email)</div>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
        <div><span class="text-muted">Company:</span> @(Model.Employee.Company != null ? L.L(Model.Employee.Company.NameAr, Model.Employee.Company.NameEn) : "")</div>
        <div><span class="text-muted">Branch:</span> @(Model.Employee.Branch != null ? L.L(Model.Employee.Branch.NameAr, Model.Employee.Branch.NameEn ?? Model.Employee.Branch.NameAr) : "")</div>
        <div><span class="text-muted">Job Title:</span> @(Model.Employee.JobTitle != null ? L.L(Model.Employee.JobTitle.NameAr, Model.Employee.JobTitle.NameEn) : "")</div>
        <div><span class="text-muted">@L.L("الإدارة", "Department"):</span> @(Model.Employee.Department != null ? L.L(Model.Employee.Department.NameAr, Model.Employee.Department.NameEn) : "—")</div>
        <div><span class="text-muted">@L.L("الكفيل", "Sponsor"):</span> @(Model.Employee.Sponsor != null ? L.L(Model.Employee.Sponsor.NameAr, Model.Employee.Sponsor.NameEn) : "—")</div>
        <div><span class="text-muted">@L.L("الجنسية", "Nationality"):</span> @L.L(Model.Employee.NationalityAr ?? "—", Model.Employee.NationalityEn ?? "—")</div>
        <div><span class="text-muted">@L.L("الراتب الأساسي", "Basic salary"):</span> @Model.Employee.BasicSalary.ToString("N2")</div>
        <div><span class="text-muted">@L.L("الجوال", "Phone"):</span> @(Model.Employee.Phone ?? "—")</div>
        <div><span class="text-muted">@L.L("تاريخ الالتحاق", "Hire date"):</span> @(Model.Employee.HireDate?.ToString("yyyy-MM-dd") ?? "—")</div>
        <div><span class="text-muted">@L.L("المسمى (من الكشف)", "Job title (sheet)"):</span> @(Model.Employee.JobTitleAr ?? "—")</div>
        <div><span class="text-muted">@L.L("رقم الهوية الوطنية", "National ID"):</span> @(Model.Employee.NationalId ?? "—") @(Model.Employee.NationalIdExpiry is DateOnly nx ? "(" + L.L("تنتهي ", "exp. ") + nx.ToString("yyyy-MM-dd") + ")" : "")</div>
        <div><span class="text-muted">@L.L("رقم الإقامة", "Iqama"):</span> @(Model.Employee.IqamaNumber ?? "—") @(Model.Employee.IqamaExpiry is DateOnly ix ? "(" + L.L("تنتهي ", "exp. ") + ix.ToString("yyyy-MM-dd") + ")" : "")</div>
        <div><span class="text-muted">@L.L("البنك", "Bank"):</span> @(Model.Employee.Financial?.BankName ?? "—")</div>
        <div><span class="text-muted">@L.L("الآيبان", "IBAN"):</span> <span dir="ltr">@(Model.Employee.Financial?.Iban ?? "—")</span></div>
    </div>
</div>

@* ── Employee status (docs/features/employee-status.md) ── *@
@{
    var stInfo = Project_HR_1.Models.Hr.EmployeeStatuses.Get(Model.Employee.Status);
    var endsWork = Project_HR_1.Models.Hr.EmployeeStatuses.EndsWork(Model.Employee.Status);
    string StPayload(bool lastDayOnly) => System.Text.Json.JsonSerializer.Serialize(new
    {
        id = Model.Employee.Id,
        name = L.L(Model.Employee.NameAr, Model.Employee.NameEn),
        status = Model.Employee.Status,
        lastDay = Model.Employee.LastWorkDate?.ToString("yyyy-MM-dd"),
        lastDayOnly,
    });
}
<div class="card p-5 mb-4" style="display:flex;align-items:center;gap:16px;flex-wrap:wrap">
    <div style="display:grid;gap:4px;flex:1;min-width:220px">
        <span class="text-sm text-muted">@L.L("حالة الموظف", "Employee status")</span>
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <partial name="_StatusBadge" model="Model.Employee" />
            @if (Model.Employee.LastWorkDate is DateOnly lwd)
            {
                <span class="text-sm">
                    <span class="text-muted">@L.L("آخر يوم عمل:", "Last working day:")</span>
                    <strong dir="ltr">@lwd.ToString("yyyy-MM-dd")</strong>
                </span>
            }
        </div>
    </div>
    @if (Model.CanEdit)
    {
        <div style="display:flex;gap:8px;flex-wrap:wrap">
            @if (endsWork)
            {
                <button type="button" class="btn btn-ghost btn-sm" data-status-edit="@StPayload(true)">
                    <i class="fa-solid fa-calendar-days me-1"></i>@L.L("تعديل آخر يوم", "Edit last day")
                </button>
            }
            <button type="button" class="btn btn-primary btn-sm" data-status-edit="@StPayload(false)">
                <i class="fa-solid fa-user-tag me-1"></i>@L.L("تغيير الحالة", "Change status")
            </button>
        </div>
    }
</div>
@if (Model.CanEdit)
{
    <partial name="_StatusModal" />
}

@* ── Login account (docs/features/employee-login-account.md) ── *@
<partial name="_LoginAccount" model="Model" />

@{
    // Same checks as the dashboard "بيانات موظفين تحتاج إكمال" widget (EntryController.Launcher).
    var emp = Model.Employee;
    var hasNid = !string.IsNullOrWhiteSpace(emp.NationalId);
    var hasIq = !string.IsNullOrWhiteSpace(emp.IqamaNumber);
    var missing = new List<string>();
    if (!hasNid && !hasIq) missing.Add(L.L("لا يوجد رقم هوية/إقامة — أضفه من «تعديل البيانات الأساسية».", "No ID/Iqama — add it via Edit basic data."));
    if (emp.Branch == null || emp.Branch.NameAr == "فرع غير محدد") missing.Add(L.L("الموظف غير مرتبط بفرع — حدده من زر «نقل الموظف».", "No branch — set it via Transfer Employee."));
    if (emp.NationalityCode == "SA" && !hasNid && hasIq) missing.Add(L.L("الجنسية سعودي لكن المسجل رقم إقامة — صحّح الجنسية أو الرقم.", "Saudi but has an Iqama number."));
    if (!string.IsNullOrEmpty(emp.NationalityCode) && emp.NationalityCode != "SA" && hasNid) missing.Add(L.L("الجنسية غير سعودي لكن المسجل رقم هوية وطنية — صحّح الجنسية أو الرقم.", "Non-Saudi but has a National ID."));
}
@if (missing.Count > 0)
{
    <div class="mb-4 rounded-lg bg-amber-50 border border-amber-200 px-4 py-3 text-sm text-amber-800">
        <div class="font-semibold mb-1"><i class="fa-solid fa-bell me-1"></i>@L.L("بيانات تحتاج إكمال", "Data to complete")</div>
        <ul class="list-disc ps-5">@foreach (var mm in missing) { <li>@mm</li> }</ul>
    </div>
}

<h2 class="text-lg font-bold text-ink mb-2">@L.L("الوثائق الرسمية", "Official Documents")</h2>
<div class="card overflow-x-auto mb-6">
    <table class="table">
        <thead>
            <tr>
                <th>@L.L("النوع", "Type")</th>
                <th>@L.L("اسم الملف", "File")</th>
                <th>@L.L("تاريخ الرفع", "Uploaded")</th>
                <th class="text-end">@L.L("إجراءات", "Actions")</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var d in Model.Employee.Documents)
        {
            <tr>
                <td>@(d.DocType == Project_HR_1.Models.Hr.EmployeeDocType.Other ? (d.CustomLabel ?? "—") : d.DocType.ToString())</td>
                <td class="text-muted text-xs">@d.FileName</td>
                <td class="text-muted text-xs">@d.UploadedAt.ToString("yyyy-MM-dd")</td>
                <td class="text-end whitespace-nowrap">
                    <a asp-action="ViewDocument" asp-route-id="@d.Id" target="_blank" class="icon-btn" title="@L.L("عرض", "View")"><i class="fa-solid fa-eye"></i></a>
                    <form asp-action="DeleteDocument" asp-route-id="@d.Id" method="post" class="inline" onsubmit="return confirm('@L.L("حذف؟", "Delete?")');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="icon-btn icon-btn-danger"><i class="fa-solid fa-trash"></i></button>
                    </form>
                </td>
            </tr>
        }
        @if (Model.Employee.Documents.Count == 0)
        {
            <tr><td colspan="4" class="text-muted text-center py-4">@L.L("لا توجد وثائق مرفوعة", "No documents uploaded.")</td></tr>
        }
        </tbody>
    </table>
</div>

<div class="flex items-center justify-between mb-2">
    <h2 class="text-lg font-bold text-ink">@L.L("الأدوار والصلاحيات", "Role Assignments")</h2>
    @if (Model.CanAssignRoles && Model.Employee.UserId != null)
    {
        <a asp-controller="RoleAssignments" asp-action="Index" class="btn btn-ghost btn-sm"><i class="fa-solid fa-people-arrows me-1"></i>@L.L("إسناد دور", "Assign role")</a>
    }
</div>
<div class="card overflow-x-auto">
    <table class="table">
        <thead>
            <tr>
                <th>@L.L("الدور", "Role")</th>
                <th>@L.L("النطاق", "Scope")</th>
                <th>@L.L("التاريخ", "Assigned at")</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model.Assignments)
        {
            <tr>
                <td>@(a.HrRole != null ? L.L(a.HrRole.NameAr, a.HrRole.NameEn) : "")</td>
                <td class="text-muted">
                    @a.ScopeLevel
                    @if (a.Company != null) { <text> · @L.L(a.Company.NameAr, a.Company.NameEn)</text> }
                    @if (a.Branch != null)  { <text> · @L.L(a.Branch.NameAr, a.Branch.NameEn ?? a.Branch.NameAr)</text> }
                </td>
                <td class="text-muted text-xs">@a.AssignedAt.ToString("yyyy-MM-dd")</td>
            </tr>
        }
        @if (Model.Assignments.Count == 0)
        {
            <tr><td colspan="3" class="text-muted text-center py-4">@L.L("لا توجد أدوار", "No assignments yet.")</td></tr>
        }
        </tbody>
    </table>
</div>

@if (Model.CanTransfer)
{
    <dialog id="modal-transfer" class="modal">
        <form method="post" asp-action="Transfer" asp-route-id="@Model.Employee.Id" id="transfer-employee-form">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-arrows-rotate"></i></span><span class="mm-txt"><small>@L.L("الموظفون", "Employees")</small>@L.L("نقل الموظف", "Transfer Employee")</span></span>
                <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 text-sm text-muted">
                    @L.L("جهة العمل الحالية:", "Current work entity:")
                    <strong>@(Model.Employee.Company != null ? L.L(Model.Employee.Company.NameAr, Model.Employee.Company.NameEn) : "—")</strong>
                    ·
                    <strong>@(Model.Employee.Branch != null ? L.L(Model.Employee.Branch.NameAr, Model.Employee.Branch.NameEn ?? Model.Employee.Branch.NameAr) : "—")</strong>
                </div>
                <div class="mb-3">
                    <label class="auth-label">@L.L("الشركة الجديدة", "New company")</label>
                    <select id="transfer-company" class="select-box">
                        <option value="">— @L.L("اختر الشركة", "Select company") —</option>
                        @foreach (var c in Model.Transfer.Companies)
                        {
                            <option value="@c.Id">@L.L(c.ShortNameAr ?? c.NameAr, c.ShortNameEn ?? c.NameEn)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="auth-label">@L.L("الفرع الجديد", "New branch")</label>
                    <select name="BranchId" id="transfer-branch" class="select-box" required>
                        <option value="">— @L.L("اختر", "select") —</option>
                        @foreach (var b in Model.Transfer.Branches)
                        {
                            <option value="@b.Id" data-company="@b.CompanyId">@L.L(b.NameAr, b.NameEn ?? b.NameAr)</option>
                        }
                    </select>
                </div>
                <div id="transfer-company-warning" class="auth-error mb-3" hidden>
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    @L.L("تنبيه: الشركة المختارة مختلفة عن شركة الموظف الحالية.", "Warning: the selected company is different from the employee's current company.")
                </div>
                <div>
                    <label class="auth-label">@L.L("سبب النقل (اختياري)", "Reason for transfer (optional)")</label>
                    <textarea name="Reason" class="auth-input" rows="2" maxlength="500"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                <button type="submit" class="btn btn-primary">@L.L("تأكيد النقل", "Confirm Transfer")</button>
            </div>
        </form>
    </dialog>

    <script>
    (function () {
        const currentCompanyId = '@Model.Employee.CompanyId';
        const coSel   = document.getElementById('transfer-company');
        const brSel   = document.getElementById('transfer-branch');
        const warning = document.getElementById('transfer-company-warning');

        function filterBranches(coId) {
            for (const opt of brSel.options) {
                if (!opt.value) continue;
                opt.hidden = !!coId && opt.dataset.company !== coId;
            }
            const cur = brSel.options[brSel.selectedIndex];
            if (cur && cur.hidden) brSel.value = '';
        }

        coSel.addEventListener('change', function () {
            filterBranches(this.value);
            warning.hidden = !this.value || this.value === currentCompanyId;
        });

        brSel.addEventListener('change', function () {
            const opt = brSel.options[brSel.selectedIndex];
            const brCompanyId = opt ? opt.dataset.company : null;
            if (brCompanyId && coSel.value !== brCompanyId) {
                coSel.value = brCompanyId;
                warning.hidden = brCompanyId === currentCompanyId;
            }
        });
    })();
    </script>
}

@if (Model.CanEdit)
{
    var fin = Model.Employee.Financial;
    <dialog id="modal-edit-basics" class="modal wide">
        <form method="post" asp-action="UpdateBasics" asp-route-id="@Model.Employee.Id">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-pen-to-square"></i></span><span class="mm-txt"><small>@L.L("الموظفون", "Employees")</small>@L.L("تعديل البيانات الأساسية", "Edit basic data")</span></span>
                <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="auth-label">@L.L("الجنسية", "Nationality")</label>
                        <select name="NationalityCode" class="select-box">
                            <option value="">—</option>
                            @foreach (var n in Project_HR_1.Models.Hr.Lookups.Nationalities)
                            {
                                <option value="@n.Code" selected="@(n.Code == Model.Employee.NationalityCode)">@L.L(n.NameAr, n.NameEn)</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="auth-label">@L.L("المسمى الوظيفي", "Job title")</label>
                        <input name="JobTitleAr" value="@Model.Employee.JobTitleAr" class="auth-input" maxlength="160" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("رقم الهوية الوطنية (للسعوديين — يبدأ بـ 1)", "National ID (starts with 1)")</label>
                        <input name="NationalId" value="@Model.Employee.NationalId" class="auth-input" inputmode="numeric" maxlength="10" dir="ltr" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("تاريخ انتهاء الهوية (ميلادي)", "National ID expiry")</label>
                        <input name="NationalIdExpiry" type="date" value="@(Model.Employee.NationalIdExpiry?.ToString("yyyy-MM-dd"))" class="auth-input" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("رقم الإقامة (لغير السعوديين — يبدأ بـ 2)", "Iqama (starts with 2)")</label>
                        <input name="IqamaNumber" value="@Model.Employee.IqamaNumber" class="auth-input" inputmode="numeric" maxlength="10" dir="ltr" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("تاريخ انتهاء الإقامة (ميلادي)", "Iqama expiry")</label>
                        <input name="IqamaExpiry" type="date" value="@(Model.Employee.IqamaExpiry?.ToString("yyyy-MM-dd"))" class="auth-input" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("رقم الجواز", "Passport")</label>
                        <input name="PassportNumber" value="@Model.Employee.PassportNumber" class="auth-input" dir="ltr" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("تاريخ انتهاء الجواز", "Passport expiry")</label>
                        <input name="PassportExpiry" type="date" value="@(Model.Employee.PassportExpiry?.ToString("yyyy-MM-dd"))" class="auth-input" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("رقم الجوال", "Mobile")</label>
                        <input name="Phone" value="@Model.Employee.Phone" class="auth-input" placeholder="05xxxxxxxx" dir="ltr" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("البريد الإلكتروني", "Email")</label>
                        <input name="Email" type="email" value="@Model.Employee.Email" class="auth-input" dir="ltr" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("الراتب الأساسي", "Basic salary")</label>
                        <input name="BasicSalary" type="number" step="0.01" value="@(Model.Employee.BasicSalary.ToString(System.Globalization.CultureInfo.InvariantCulture))" class="auth-input" />
                    </div>
                    <div>
                        <label class="auth-label">@L.L("البنك", "Bank")</label>
                        <select name="BankName" class="select-box">
                            <option value="">—</option>
                            @foreach (var bk in Project_HR_1.Models.Hr.Lookups.SaudiBanks)
                            {
                                <option value="@bk.NameAr" selected="@(bk.NameAr == fin?.BankName)">@L.L(bk.NameAr, bk.NameEn)</option>
                            }
                        </select>
                    </div>
                    <div class="md:col-span-2">
                        <label class="auth-label">@L.L("الآيبان (SA + 22 رقم)", "IBAN (SA + 22 digits)")</label>
                        <input name="Iban" value="@(fin?.Iban)" class="auth-input" dir="ltr" maxlength="40" placeholder="SA0000000000000000000000" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                <button type="submit" class="btn btn-primary">@L.L("حفظ", "Save")</button>
            </div>
        </form>
    </dialog>
    @if (TempData["reopenEdit"] is bool reopen && reopen)
    {
        <script>document.getElementById('modal-edit-basics')?.showModal();</script>
    }
}
