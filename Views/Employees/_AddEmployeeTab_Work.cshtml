@model Project_HR_1.Models.ViewModels.Management.AddEmployeeVM

<h4 class="font-semibold mb-2">@L.L("بيانات م. العمل", "Job Assignment")</h4>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div>
        <label asp-for="ActualJobTitleId" class="auth-label">@L.L("المسمى الوظيفي الفعلي", "Actual job title")</label>
        <select asp-for="ActualJobTitleId" class="select-box">
            <option value="">@L.L("بدون", "None")</option>
            @foreach (var j in Model.JobTitles)
            {
                <option value="@j.Id">@L.L(j.NameAr, j.NameEn)</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="DirectSupervisorId" class="auth-label">@L.L("المشرف المباشر", "Direct supervisor")</label>
        <select asp-for="DirectSupervisorId" class="select-box">
            <option value="">@L.L("بدون", "None")</option>
            @foreach (var s in Model.Supervisors)
            {
                <option value="@s.Id">@L.L(s.NameAr, s.NameEn)</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="WorkLocation" class="auth-label">@L.L("موقع العمل", "Work location")</label>
        <input asp-for="WorkLocation" class="auth-input" />
    </div>
    <div>
        <label asp-for="WorkSystem" class="auth-label">@L.L("نظام الدوام", "Work system")</label>
        <select asp-for="WorkSystem" class="select-box">
            <option value="FullTime">@L.L("دوام كامل", "Full time")</option>
            <option value="PartTime">@L.L("دوام جزئي", "Part time")</option>
            <option value="Remote">@L.L("عن بعد", "Remote")</option>
        </select>
    </div>
    <div>
        <label asp-for="DailyWorkHours" class="auth-label">@L.L("ساعات العمل اليومية", "Daily work hours")</label>
        <input asp-for="DailyWorkHours" type="number" step="0.5" class="auth-input" />
    </div>
</div>

<h4 class="font-semibold mb-2">@L.L("بيانات العقد", "Contract Info")</h4>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div>
        <label asp-for="ContractType" class="auth-label">@L.L("نوع العقد", "Contract type")</label>
        <select asp-for="ContractType" data-contract-type class="select-box">
            <option value="Limited">@L.L("محدد المدة", "Limited")</option>
            <option value="Unlimited">@L.L("غير محدد المدة", "Unlimited")</option>
        </select>
    </div>
    <div></div>
    <div>
        <label asp-for="ContractStartDate" class="auth-label">@L.L("تاريخ بداية العقد", "Contract start date")</label>
        <input asp-for="ContractStartDate" type="date" class="auth-input" />
    </div>
    <div data-contract-end-wrap class="hidden">
        <label asp-for="ContractEndDate" class="auth-label">@L.L("تاريخ نهاية العقد", "Contract end date")</label>
        <input asp-for="ContractEndDate" type="date" class="auth-input" />
    </div>
    <div>
        <label asp-for="ContractDurationMonths" class="auth-label">@L.L("مدة العقد (أشهر)", "Contract duration (months)")</label>
        <input asp-for="ContractDurationMonths" type="number" min="1" class="auth-input" />
    </div>
    <div>
        <label asp-for="ProbationDays" class="auth-label">@L.L("فترة التجربة (أيام)", "Probation period (days)")</label>
        <input asp-for="ProbationDays" type="number" min="0" class="auth-input" />
    </div>
    <div class="md:col-span-2">
        <button type="button" id="add-preview-contract-btn" class="btn btn-ghost btn-sm">
            <i class="fa-solid fa-print me-1"></i>@L.L("معاينة العقد", "Preview Contract")
        </button>
        <span class="text-xs text-muted ms-2">
            @L.L("يولّد عقداً من قالب ببيانات الشاشة الحالية، قبل الحفظ النهائي.",
                 "Generates a contract from a template using the current screen data, before final save.")
        </span>
    </div>
</div>

<h4 class="font-semibold mb-2">@L.L("الإجازات", "Leave Balance")</h4>
<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
        <label asp-for="AnnualLeaveBalance" class="auth-label">@L.L("رصيد الإجازة السنوية", "Annual leave balance")</label>
        <input asp-for="AnnualLeaveBalance" type="number" min="0" class="auth-input" />
    </div>
    <div>
        <label asp-for="LastLeaveDate" class="auth-label">@L.L("تاريخ آخر إجازة", "Last leave date")</label>
        <input asp-for="LastLeaveDate" type="date" class="auth-input" />
    </div>
    <div>
        <label asp-for="SickLeaveUsedDays" class="auth-label">@L.L("رصيد الإجازة المرضية المستخدم", "Sick leave used (days)")</label>
        <input asp-for="SickLeaveUsedDays" type="number" min="0" class="auth-input" />
    </div>
</div>
