<partial name="_StatusModal" />

@if (Model.CanCreate)
{
    <dialog id="modal-create" class="modal wide">
        <form method="post" asp-action="Create" enctype="multipart/form-data" id="add-employee-form">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-user-plus"></i></span><span class="mm-txt"><small>@L.L("الموظفون", "Employees")</small>@L.L("إضافة موظف", "Add Employee")</span></span>
                <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <partial name="_AddEmployeeFields" model="addVm" />
            </div>
            <div class="modal-footer flex-wrap gap-2">
                <button type="button" class="btn btn-ghost" data-modal-close>@L.L("خروج", "Close")</button>
                <button type="reset" class="btn btn-ghost">@L.L("مسح البيانات", "Clear")</button>
                <button type="submit" id="add-save-new-btn" name="SaveAndAddAnother" value="true" class="btn btn-ghost">
                    @L.L("حفظ وإضافة آخر", "Save & Add Another")
                </button>
                <button type="submit" class="btn btn-primary">@L.L("حفظ البيانات", "Save")</button>
            </div>
        </form>
    </dialog>

    <script>
    (function () {
        const shouldReopen = @Html.Raw((TempData["reopenAddModal"] is bool b && b) || (ViewData["reopenAddModal"] is bool v && v) ? "true" : "false");
        if (shouldReopen) document.getElementById('modal-create')?.showModal();
    })();
    </script>
}

@functions {
    // Wraps every match of the search term in <mark class="hl-q"> (bold + dark). Text is HTML-encoded.
    private Microsoft.AspNetCore.Html.IHtmlContent Hl(string? text)
    {
        var q = Model.Filter?.Q?.Trim();
        if (string.IsNullOrEmpty(text) || string.IsNullOrEmpty(q)) return new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text ?? ""));
        var sb = new System.Text.StringBuilder(); int pos = 0;
        while (true)
        {
            var i = text.IndexOf(q, pos, StringComparison.OrdinalIgnoreCase);
            if (i < 0) break;
            sb.Append(System.Net.WebUtility.HtmlEncode(text[pos..i])).Append("<mark class=\"hl-q\">").Append(System.Net.WebUtility.HtmlEncode(text.Substring(i, q.Length))).Append("</mark>");
            pos = i + q.Length;
        }
        sb.Append(System.Net.WebUtility.HtmlEncode(text[pos..]));
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}
