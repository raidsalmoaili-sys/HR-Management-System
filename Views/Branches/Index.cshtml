@model Project_HR_1.Models.ViewModels.Management.BranchesListVM
@{ ViewData["Title"] = "Branches"; }

@if (TempData["Error"] is string errMsg)
{
    <div class="mb-4 rounded-lg bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-700 flex items-center gap-2">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span>@errMsg</span>
    </div>
}

<div class="page-head">
    <div>
        <h2>@L.L("الفروع", "Branches")</h2>
        <div class="sub">@L.L("إدارة فروع الشركات", "Manage branches across companies")</div>
    </div>
    <div class="page-head-actions">
        @if (Model.CanCreate)
        {
            <button type="button" class="btn btn-accent btn-sm" data-modal-open="modal-create">
                <i class="fa-solid fa-plus me-1"></i>@L.L("إضافة فرع", "Add Branch")
            </button>
        }
    </div>
</div>

<div class="data-card">
    <div class="card-head">
        <div class="card-title"><i class="fa-solid fa-code-branch"></i>@L.L("قائمة الفروع", "All Branches")</div>
        <span class="text-xs text-muted">@Model.Branches.Count @L.L("سجل", "rows")</span>
    </div>
    <form method="get" class="filter-bar">
        <div class="search">
            <input type="text" name="q" placeholder="@L.L("بحث…", "Search…")" disabled />
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <select name="companyId" class="select-box" onchange="this.form.submit()">
            <option value="">@L.L("كل الشركات", "All companies")</option>
            @foreach (var c in Model.Companies)
            {
                var sel = Model.CompanyFilter == c.Id ? "selected" : null;
                <option value="@c.Id" selected="@sel">@L.L(c.NameAr, c.NameEn)</option>
            }
        </select>
    </form>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@L.L("الفرع", "Branch")</th>
                    <th>@L.L("الشركة", "Company")</th>
                    <th>@L.L("المدينة", "City")</th>
                    <th>@L.L("الحي", "District")</th>
                    <th>@L.L("المدير", "Manager")</th>
                    <th class="text-center">@L.L("الموظفون", "Employees")</th>
                    <th class="text-end">@L.L("إجراءات", "Actions")</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.Branches.Count == 0)
            {
                <tr class="empty"><td colspan="7">@L.L("لا توجد فروع", "No branches.")</td></tr>
            }
            @foreach (var b in Model.Branches)
            {
                <tr>
                    <td>
                        <div class="font-semibold">@L.L(b.NameAr, b.NameEn ?? b.NameAr)</div>
                        @if (b.IsPrimary) { <span class="badge badge-warning text-[10px] mt-1">@L.L("رئيسي", "Primary")</span> }
                    </td>
                    <td class="text-muted">@(b.Company != null ? L.L(b.Company.NameAr, b.Company.NameEn) : "—")</td>
                    <td class="text-muted">@(b.City ?? "—")</td>
                    <td class="text-muted">@(b.DistrictName ?? "—")</td>
                    <td class="text-muted">—</td>
                    <td class="text-center">@b.EmployeesCount</td>
                    <td class="text-end whitespace-nowrap">
                        @if (Model.CanEdit)
                        {
                            <button type="button" class="icon-btn" data-modal-open="modal-edit-@b.Id" title="@L.L("تعديل", "Edit")"><i class="fa-solid fa-pen"></i></button>
                        }
                        @if (Model.CanDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@b.Id" method="post" class="inline" onsubmit="return confirm('@L.L("حذف الفرع؟", "Delete this branch?")');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-btn icon-btn-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanCreate)
{
    var emptyVm = new Project_HR_1.Models.ViewModels.Management.BranchEditVM { Companies = Model.Companies };
    <dialog id="modal-create" class="modal">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-code-branch"></i></span><span class="mm-txt"><small>@L.L("الفروع", "Branches")</small>@L.L("إضافة فرع", "New Branch")</span></span>
                <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <partial name="_BranchFields" model="emptyVm" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                <button type="submit" class="btn btn-primary">@L.L("إنشاء", "Create")</button>
            </div>
        </form>
    </dialog>
}

@if (Model.CanEdit)
{
    foreach (var b in Model.Branches)
    {
        var vm = new Project_HR_1.Models.ViewModels.Management.BranchEditVM
        {
            Id = b.Id, CompanyId = b.CompanyId,
            NameAr = b.NameAr, NameEn = b.NameEn,
            IsPrimary = b.IsPrimary,
            LicenseNumber = b.LicenseNumber, LicenseStartDate = b.LicenseStartDate, LicenseEndDate = b.LicenseEndDate,
            VatNumber     = b.VatNumber,     VatStartDate     = b.VatStartDate,     VatEndDate     = b.VatEndDate,
            NatAddressShort = b.NatAddressShort, NatAddressRegDate = b.NatAddressRegDate,
            BuildingNumber  = b.BuildingNumber,  StreetName = b.StreetName,
            SecondaryNumber = b.SecondaryNumber, DistrictName = b.DistrictName,
            PostalCode = b.PostalCode, City = b.City,
            Companies = Model.Companies,
        };
        <dialog id="modal-edit-@b.Id" class="modal">
            <form method="post" asp-action="Edit" asp-route-id="@b.Id">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-pen-to-square"></i></span><span class="mm-txt"><small>@L.L("الفروع", "Branches")</small>@L.L("تعديل الفرع", "Edit Branch")</span></span>
                    <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="modal-body">
                    <partial name="_BranchFields" model="vm" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                    <button type="submit" class="btn btn-primary">@L.L("حفظ", "Save")</button>
                </div>
            </form>
        </dialog>
    }
}
