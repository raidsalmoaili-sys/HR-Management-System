@model Project_HR_1.Models.ViewModels.Management.JobTitlesListVM
@{ ViewData["Title"] = "Job Titles"; }

<div class="page-head">
    <div>
        <h2>@L.L("المسميات الوظيفية", "Job Titles")</h2>
        <div class="sub">@L.L("كتالوج المسميات الوظيفية لكل شركة", "Per-company position catalog")</div>
    </div>
    <div class="page-head-actions">
        @if (Model.CanCreate)
        {
            <button type="button" class="btn btn-accent btn-sm" data-modal-open="modal-create">
                <i class="fa-solid fa-plus me-1"></i>@L.L("إضافة مسمى", "Add Job Title")
            </button>
        }
    </div>
</div>

<div class="data-card">
    <div class="card-head">
        <div class="card-title"><i class="fa-solid fa-id-badge"></i>@L.L("كل المسميات", "All Job Titles")</div>
        <span class="text-xs text-muted">@Model.JobTitles.Count @L.L("سجل", "rows")</span>
    </div>
    <form method="get" class="filter-bar">
        <div class="search">
            <input type="text" name="q" placeholder="@L.L("بحث…", "Search…")" disabled />
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <select name="companyId" class="select-box" onchange="this.form.submit()">
            <option value="">@L.L("كل الشركات", "All companies")</option>
            @foreach (var c in Model.Companies)
            {
                var sel = Model.CompanyFilter == c.Id ? "selected" : null;
                <option value="@c.Id" selected="@sel">@L.L(c.NameAr, c.NameEn)</option>
            }
        </select>
    </form>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>@L.L("الرمز", "Code")</th>
                    <th>@L.L("المسمى", "Title")</th>
                    <th>@L.L("الشركة", "Company")</th>
                    <th class="text-center">@L.L("نشط", "Active")</th>
                    <th class="text-end">@L.L("إجراءات", "Actions")</th>
                </tr>
            </thead>
            <tbody>
            @if (Model.JobTitles.Count == 0)
            {
                <tr class="empty"><td colspan="5">@L.L("لا توجد مسميات", "No job titles.")</td></tr>
            }
            @foreach (var j in Model.JobTitles)
            {
                <tr>
                    <td class="text-muted text-xs">@j.Code</td>
                    <td class="font-semibold">@L.L(j.NameAr, j.NameEn)</td>
                    <td class="text-muted">@(j.Company != null ? L.L(j.Company.NameAr, j.Company.NameEn) : "—")</td>
                    <td class="text-center">
                        @if (j.IsActive)
                        {
                            <span class="badge badge-success">@L.L("نشط", "Active")</span>
                        }
                        else
                        {
                            <span class="badge badge-muted">@L.L("متوقف", "Inactive")</span>
                        }
                    </td>
                    <td class="text-end whitespace-nowrap">
                        @if (Model.CanEdit)
                        {
                            <button type="button" class="icon-btn" data-modal-open="modal-edit-@j.Id"><i class="fa-solid fa-pen"></i></button>
                        }
                        @if (Model.CanDelete)
                        {
                            <form asp-action="Delete" asp-route-id="@j.Id" method="post" class="inline" onsubmit="return confirm('@L.L("حذف؟", "Delete?")');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="icon-btn icon-btn-danger"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanCreate)
{
    var emptyVm = new Project_HR_1.Models.ViewModels.Management.JobTitleEditVM { Companies = Model.Companies };
    <dialog id="modal-create" class="modal">
        <form method="post" asp-action="Create">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-id-badge"></i></span><span class="mm-txt"><small>@L.L("المسميات الوظيفية", "Job titles")</small>@L.L("مسمى جديد", "New Job Title")</span></span>
                <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <partial name="_JobTitleFields" model="emptyVm" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                <button type="submit" class="btn btn-primary">@L.L("إنشاء", "Create")</button>
            </div>
        </form>
    </dialog>
}

@if (Model.CanEdit)
{
    foreach (var j in Model.JobTitles)
    {
        var vm = new Project_HR_1.Models.ViewModels.Management.JobTitleEditVM
        {
            Id = j.Id, CompanyId = j.CompanyId, Code = j.Code,
            NameAr = j.NameAr, NameEn = j.NameEn, IsActive = j.IsActive,
            Companies = Model.Companies,
        };
        <dialog id="modal-edit-@j.Id" class="modal">
            <form method="post" asp-action="Edit" asp-route-id="@j.Id">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <span class="modal-title"><span class="mm-ico"><i class="fa-solid fa-pen-to-square"></i></span><span class="mm-txt"><small>@L.L("المسميات الوظيفية", "Job titles")</small>@L.L("تعديل المسمى", "Edit Job Title")</span></span>
                    <button type="button" class="modal-close" data-modal-close><i class="fa-solid fa-xmark"></i></button>
                </div>
                <div class="modal-body">
                    <partial name="_JobTitleFields" model="vm" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" data-modal-close>@L.L("إلغاء", "Cancel")</button>
                    <button type="submit" class="btn btn-primary">@L.L("حفظ", "Save")</button>
                </div>
            </form>
        </dialog>
    }
}
